/* =====================================================================
 *  LaptopPrep - resources (prep.rc)
 *
 *  windres needs -I src so that both this include and the icon are found
 *  no matter which directory the build is started from:
 *      windres -I src src/prep.rc -O coff -o build/prep.res
 * ===================================================================== */
#include <windows.h>
#include "resource.h"

/* ---- the application icon ---------------------------------------- */
IDI_APPICON  ICON  "laptopprep.ico"

/* ---- the manifest: per-monitor DPI, common controls 6 -------------- *
 *  Without the DPI entry Windows bitmap-stretches the window on a
 *  125%/150% laptop screen, which is exactly the "countable pixels" look.
 *  The window is DPI aware and lays itself out again instead.            */
1 RT_MANIFEST "laptopprep.manifest"

/* ---- version information ------------------------------------------ *
 *  Keep the numbers in step with PREP_VERSION_STR in prep.h.            */
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,2,0,0
 PRODUCTVERSION 1,2,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Wintr & AGPCS"
            VALUE "FileDescription",  "LaptopPrep - refurbishment console for Windows laptops"
            VALUE "FileVersion",      "1.2"
            VALUE "InternalName",     "LaptopPrep"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Wintr & AGPCS. All rights reserved."
            VALUE "OriginalFilename", "LaptopPrep.exe"
            VALUE "ProductName",      "LaptopPrep"
            VALUE "ProductVersion",   "1.2"
            VALUE "Comments",         "Made for Wintr (https://wintr.lol) and AGPCS (https://agpcs.nl). Licensed to Wintr and AGPCS and their customers; copying, redistributing or using this tool without written permission is not allowed."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
